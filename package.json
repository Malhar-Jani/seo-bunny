{
  "name": "seobunny",
  "version": "2.1.0",
  "description": "SEO Bunny — Local SEO & Maps Rank Tracker",
  "main": "electron/dist/main.js",
  "scripts": {
    "setup:local": "node scripts/setup-local.js",
    "test": "node --test tests/*.test.cjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "electron:dev": "node scripts/electron-dev.js",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:prepare": "node scripts/build-desktop.js && node scripts/copy-static.js && npm run electron:compile && npm run verify",
    "electron:build": "npm run electron:prepare && electron-builder",
    "electron:build:mac": "npm run electron:prepare && electron-builder --mac",
    "electron:build:win": "npm run electron:prepare && electron-builder --win",
    "electron:build:linux": "npm run electron:prepare && electron-builder --linux",
    "electron:publish": "npm run electron:prepare && electron-builder --publish always",
    "verify": "node scripts/verify-build.js --packaged",
    "test:splash": "electron scripts/test-splash.js",
    "typecheck": "tsc --noEmit",
    "check:public": "node scripts/check-public.cjs",
    "setup:ci": "node scripts/setup-ci.cjs",
    "demo": "node scripts/demo.cjs"
  },
  "keywords": [],
  "author": "Mal",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.29.2",
    "google-auth-library": "^11.3.1",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "natural": "^8.1.0",
    "next": "^16.4.5",
    "playwright-core": "^1.58.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "sentiment": "^5.0.2",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.9.3",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.24",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.58.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "^1.1.21",
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
